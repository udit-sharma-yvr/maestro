# --- Maestro configuration (env prefix: MAESTRO_) ---

# LLM provider: anthropic | openai | bedrock
MAESTRO_LLM_PROVIDER=anthropic

# Cheap model used for routing + simple answers; strong model used for tool-use.
MAESTRO_ROUTER_MODEL=claude-3-5-haiku-20241022
MAESTRO_AGENT_MODEL=claude-3-5-sonnet-20241022

# Directory the MCP filesystem tools operate within (relative to repo root).
MAESTRO_SANDBOX_ROOT=sandbox

# Server bind.
MAESTRO_HOST=127.0.0.1
MAESTRO_PORT=8000

# --- Provider credentials (set the one matching MAESTRO_LLM_PROVIDER) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# For bedrock, use standard AWS env (AWS_PROFILE / AWS_REGION / AWS_ACCESS_KEY_ID ...).
